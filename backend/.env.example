PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/erefs
JWT_SECRET=your_random_jwt_secret_here

# LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=VouchMetrics <noreply@vouchmetrics.com>

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# LinkedIn OAuth  (Sign In with LinkedIn using OpenID Connect)
# 1. Go to https://www.linkedin.com/developers/apps → Create app
# 2. Add product: "Sign In with LinkedIn using OpenID Connect"
# 3. Under Auth tab → add Authorized redirect URL:
#    http://localhost:4000/api/auth/linkedin/callback   (dev)
#    https://your-api.example.com/api/auth/linkedin/callback  (prod)
# 4. Copy Client ID and Client Secret below
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
#
# Scopes granted by standard Sign-In:  openid, profile, email
#   → Available data: name, email, profile photo
#   → Work history / skills require LinkedIn's Partner Programme (restricted access)
#     Apply at: https://business.linkedin.com/marketing-solutions/marketing-partners
